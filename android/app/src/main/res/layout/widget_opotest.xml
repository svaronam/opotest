<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">
        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpoTest"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_sub"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingBottom="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Cargando…"
            android:textColor="#B4BDD0"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="50"
        android:progress="0"
        android:progressTint="#FF6F98"
        android:progressBackgroundTint="#55B4BDD0" />

    <TextView
        android:id="@+id/w_pend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="#E7EBF3"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_five"
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="▶  5 minutos"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_rep"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn2"
            android:gravity="center"
            android:text="Repaso"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
