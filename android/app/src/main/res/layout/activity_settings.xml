<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Conectar con la Raspberry" android:textSize="22sp" android:textStyle="bold"
        android:textColor="@color/ink" android:layout_marginBottom="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#4A5878" android:textSize="15sp" android:layout_marginBottom="20dp"
        android:text="Activa Tailscale en el móvil y escribe la dirección del servidor. Con MagicDNS basta con el nombre de la Pi; si no, usa su IP 100.x.x.x." />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Dirección del servidor" android:textColor="@color/ink" />
    <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textUri" android:hint="http://homelab2:8790" android:minHeight="48dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Token (déjalo vacío si no lo configuraste)" android:textColor="@color/ink" android:layout_marginTop="12dp" />
    <EditText android:id="@+id/token" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textVisiblePassword" android:minHeight="48dp" />

    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textSize="14sp" />

    <Button android:id="@+id/test" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Probar conexión" />
    <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Guardar y abrir" />
</LinearLayout>
</ScrollView>
